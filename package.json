{
  "name": "siear",
  "version": "0.1.0",
  "description": "Sistema Inteligente de Escrita Assistida de Relatórios",
  "main": "dist-electron/main.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --config vite.worker.config.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "benchmark:baseline": "node --env-file=.env ./node_modules/vitest/vitest.mjs run --config vitest.baseline.config.ts",
    "benchmark:checkpoint": "node --env-file=.env ./node_modules/vitest/vitest.mjs run --config vitest.checkpoint-benchmark.config.ts",
    "benchmark:workers": "node --env-file=.env ./node_modules/vitest/vitest.mjs run --config vitest.cpu-worker-benchmark.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "br.edu.siear.app",
    "productName": "SIEAR",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^1.1.1",
    "vitest": "^4.1.11"
  }
}
